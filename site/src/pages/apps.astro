---
// /apps: the link-in-bio page for Instagram (@buildbyashu).
// Approved design: vault Startups/Marketing/Design/2026-11-22 Apps Link Page Preview v2.html
import '../styles/site.css';
import { SITE } from '../lib/seo';
import { getApps, SHOW_FIRST } from '../lib/apps';

const { featured, rest } = await getApps();
const title = 'Apps by Ashutosh Wahane';
const description = 'Small apps that each fix one annoying thing: ' +
  [featured, ...rest].filter(Boolean).map((a) => `${a!.data.title} (${a!.data.apps!.platformLabel})`).join(', ') + '.';
const canonical = new URL('/apps/', Astro.site);
const FILTERS = [['iphone', 'iPhone'], ['android', 'Android'], ['mac', 'Mac']] as const;
const counts = FILTERS.map(([k, l]) => [k, l, rest.filter((a) => a.data.apps!.platforms.includes(k)).length] as const).filter(([, , n]) => n > 0);
const showChips = rest.length >= 4;
const collapse = rest.length > SHOW_FIRST + 2;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  <link rel="icon" href="/assets/img/favicon.ico">
  <meta property="og:type" content="website">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:site_name" content={SITE.name}>
  <meta property="og:image" content={SITE.defaultImage}>
  <meta name="twitter:card" content="summary_large_image">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&family=Space+Grotesk:wght@400;500;600&display=swap">
</head>
<body class="apps-page">
<main class="ap">
  <div class="ap-top">
    <a class="brand" href="/">AW<sup>®</sup></a>
    <a href="https://www.instagram.com/buildbyashu/">@buildbyashu ↗</a>
  </div>

  <section class="ap-intro">
    <h1>Apps I build, <em>one fix each</em></h1>
    <p>I'm Ashutosh. Tap the one from the reel you just watched.</p>
  </section>

  {featured && (
    <article class="ap-feat" aria-label="Featured app">
      <div class="txt">
        <span class="flag"><i></i>This week's reels</span>
        <div class="name">
          {(featured.data.apps!.icon ?? featured.data.icon) && <img src={featured.data.apps!.icon ?? featured.data.icon} alt="" width="40" height="40">}
          <h2>{featured.data.title}</h2>
        </div>
        <span class="plat">{featured.data.apps!.platformLabel}</span>
        <p class="tag">{featured.data.tagline}</p>
      </div>
      <div class={`shot theme-${featured.data.theme}`}>
        <div class="ap-phone">
          {(featured.data.apps!.shot ?? featured.data.screenshot)
            ? <img src={featured.data.apps!.shot ?? featured.data.screenshot} alt={featured.data.screenshotAlt ?? `${featured.data.title} screenshot`}>
            : <div class="mock">{Array.from({ length: 9 }, () => <i />)}</div>}
        </div>
      </div>
      <div class="ctas">
        {featured.data.apps!.links.map((l) => <a class:list={['ap-btn', { ghost: l.ghost }]} href={l.href}>{l.label}</a>)}
      </div>
    </article>
  )}

  {rest.length > 0 && (
    <section aria-labelledby="all-h">
      <div class="ap-grid-head"><b id="all-h">More apps</b><span>{rest.length} {rest.length === 1 ? 'app' : 'apps'}</span></div>
      {showChips && (
        <div class="ap-chips" role="group" aria-label="Filter by device">
          <button type="button" data-f="all" aria-pressed="true">All<span>{rest.length}</span></button>
          {counts.map(([k, l, n]) => <button type="button" data-f={k} aria-pressed="false">{l}<span>{n}</span></button>)}
        </div>
      )}
      <div class:list={['ap-grid', { solo: rest.length === 1 }]} id="ap-grid">
        {rest.map((a) => {
          const app = a.data.apps!;
          return (
            <a class="ap-tile" href={app.links[0].href} data-p={app.platforms.join(' ')}>
              <div class={`vis theme-${a.data.theme}`}>
                <div class="ap-phone">
                  {(app.shot ?? a.data.screenshot)
                    ? <img src={app.shot ?? a.data.screenshot} alt={a.data.screenshotAlt ?? `${a.data.title} screenshot`} loading="lazy">
                    : <div class="mock">{Array.from({ length: 9 }, () => <i />)}</div>}
                </div>
              </div>
              <div class="bd">
                <div class="row">
                  {(app.icon ?? a.data.icon) ? <img src={app.icon ?? a.data.icon} alt="" width="26" height="26" loading="lazy"> : <span class={`ic theme-${a.data.theme}`} />}
                  <h3>{a.data.title}</h3>
                </div>
                <span class="plat">{app.platformLabel}</span>
                <p>{app.line}</p>
                <span class="get">{app.links[0].store ?? 'Open'} ↗</span>
              </div>
            </a>
          );
        })}
        <p class="ap-empty" hidden>No apps for this device yet.</p>
      </div>
      {collapse && <button type="button" class="ap-more" id="ap-more" hidden></button>}
    </section>
  )}

  <footer class="ap-foot">
    <a href="/">ashutoshwahane.dev</a>
    <a href="/work/">All my work</a>
    <a href="/dialback/privacy/">Dialback privacy</a>
  </footer>
</main>

<script define:vars={{ SHOW_FIRST, collapse }}>
  // Without JS every tile shows. With JS: device filter chips and "Show all".
  const tiles = [...document.querySelectorAll('.ap-tile')];
  const empty = document.querySelector('.ap-empty');
  const more = document.getElementById('ap-more');
  let filter = 'all', expanded = false;
  function apply() {
    const match = tiles.filter((t) => filter === 'all' || t.dataset.p.split(' ').includes(filter));
    const cut = collapse && !expanded && match.length > SHOW_FIRST + 2 ? SHOW_FIRST : match.length;
    tiles.forEach((t) => { t.hidden = true; });
    match.slice(0, cut).forEach((t) => { t.hidden = false; });
    if (empty) empty.hidden = match.length > 0;
    if (more) { more.hidden = cut === match.length; more.textContent = `Show all ${match.length} apps`; }
  }
  document.querySelector('.ap-chips')?.addEventListener('click', (e) => {
    const b = e.target.closest('button'); if (!b) return;
    filter = b.dataset.f; expanded = false;
    document.querySelectorAll('.ap-chips button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    apply();
  });
  more?.addEventListener('click', () => { expanded = true; apply(); });
  apply();
</script>
</body>
</html>

<style is:global>
  .apps-page .ap{max-width:440px;margin:0 auto;padding:24px max(16px,env(safe-area-inset-left,0px)) 40px}
  @media (min-width:760px){.apps-page .ap{max-width:720px}}
  .ap-top{display:flex;justify-content:space-between;align-items:center;font:11px var(--f-mono);letter-spacing:.1em;color:var(--mist-dim);text-transform:uppercase;padding-bottom:16px;border-bottom:1px solid var(--teal-line)}
  .ap-top a:hover{color:var(--amber)}
  .ap-top .brand{color:var(--cream);text-transform:none}
  .ap-intro{padding:20px 0 16px}
  .ap-intro h1{font:400 30px/1.08 var(--f-display);letter-spacing:-.04em;margin:0 0 8px}
  .ap-intro p{margin:0;font-size:14px;line-height:1.55;color:var(--mist)}

  .ap-phone{border-radius:18px 18px 0 0;padding:5px 5px 0;background:#111;box-shadow:0 14px 34px #0008,inset 0 0 0 1px #ffffff22;overflow:hidden}
  .ap-phone img,.ap-phone .mock{display:block;width:100%;aspect-ratio:9/16;object-fit:cover;object-position:top;border-radius:13px 13px 0 0}
  .ap-phone .mock{background:linear-gradient(170deg,#1e2a33,#0d1419);padding:18% 10% 0;display:grid;grid-template-columns:repeat(3,1fr);gap:8%;align-content:start}
  .ap-phone .mock i{aspect-ratio:1;border-radius:22%;background:#ffffff1c}

  .ap-feat{display:grid;grid-template-columns:1fr 132px;border:1px solid var(--teal-line);border-radius:10px;overflow:hidden;background:var(--teal-deep)}
  .ap-feat .txt{padding:20px 16px 16px;display:grid;gap:8px;align-content:start}
  .ap-feat .flag{font:11px var(--f-mono);letter-spacing:.08em;text-transform:uppercase;color:var(--lime);display:flex;align-items:center;gap:8px}
  .ap-feat .flag i{width:6px;height:6px;border-radius:50%;background:currentColor}
  .ap-feat .name{display:flex;align-items:center;gap:10px}
  .ap-feat .name img{width:40px;height:40px;border-radius:10px;box-shadow:0 0 0 1px #ffffff22}
  .ap-feat h2{font:500 24px var(--f-display);letter-spacing:-.03em;margin:0}
  .ap-feat .plat{font:11px var(--f-mono);letter-spacing:.08em;text-transform:uppercase;color:var(--mist-dim)}
  .ap-feat .tag{font:italic 15px/1.35 var(--f-serif);color:var(--lime);margin:0}
  .ap-feat .shot{display:flex;align-items:flex-end;justify-content:center;padding:20px 16px 0}
  .ap-feat .shot .ap-phone{width:100%;transform:translateY(8px)}
  .ap-feat .ctas{grid-column:1/-1;display:grid;gap:8px;padding:0 16px 16px;margin-top:8px}
  .ap-btn{display:flex;justify-content:center;align-items:center;gap:8px;min-height:48px;font:500 12px var(--f-mono);letter-spacing:.06em;padding:12px 16px;border-radius:4px;background:var(--cream);color:var(--teal)}
  .ap-btn:hover{background:var(--lime)}
  .ap-btn.ghost{background:transparent;color:var(--cream);border:1px solid #ffffff40;min-height:44px}

  .ap-grid-head{display:flex;justify-content:space-between;align-items:baseline;margin:28px 0 12px;font:11px var(--f-mono);letter-spacing:.1em;text-transform:uppercase;color:var(--mist-dim)}
  .ap-grid-head b{font:500 18px var(--f-display);letter-spacing:-.02em;text-transform:none;color:var(--cream)}
  .ap-chips{display:flex;gap:6px;overflow-x:auto;margin:0 -16px;padding:0 16px 12px;scrollbar-width:none}
  .ap-chips button{flex:none;font:11px var(--f-mono);letter-spacing:.06em;padding:8px 12px;border-radius:20px;border:1px solid #ffffff33;background:transparent;color:var(--mist);min-height:36px}
  .ap-chips button[aria-pressed="true"]{background:var(--cream);color:var(--teal);border-color:var(--cream)}
  .ap-chips button span{opacity:.6;margin-left:4px}
  .ap-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
  @media (min-width:760px){.ap-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
  .ap-tile{display:grid;grid-template-rows:auto 1fr;border:1px solid var(--teal-line);border-radius:10px;overflow:hidden;background:var(--teal-deep);transition:border-color .2s}
  .ap-tile[hidden],.ap-empty[hidden],.ap-more[hidden]{display:none}
  .ap-tile:hover{border-color:#ffffff45}
  .ap-tile .vis{aspect-ratio:1/1;display:flex;align-items:flex-end;justify-content:center;padding:16px 18% 0;overflow:hidden}
  .ap-tile .vis .ap-phone{width:100%;transform:translateY(10%);transition:transform .3s ease}
  .ap-tile:hover .vis .ap-phone{transform:translateY(calc(10% - 4px))}
  @media (prefers-reduced-motion:reduce){.ap-tile .vis .ap-phone{transition:none}.ap-tile:hover .vis .ap-phone{transform:translateY(10%)}}
  .ap-tile .bd{padding:12px;display:grid;gap:4px;align-content:start}
  .ap-tile .row{display:flex;align-items:center;gap:8px}
  .ap-tile .row img,.ap-tile .row .ic{width:26px;height:26px;border-radius:7px;flex:none;box-shadow:0 0 0 1px #ffffff22}
  .ap-tile h3{font:500 16px var(--f-display);letter-spacing:-.02em;margin:0;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .ap-tile .plat{font:11px var(--f-mono);letter-spacing:.08em;text-transform:uppercase;color:var(--mist-dim)}
  .ap-tile p{margin:2px 0 0;font-size:13px;line-height:1.45;color:var(--mist);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
  .ap-tile .get{margin-top:4px;font:11px var(--f-mono);letter-spacing:.06em;color:var(--lime)}
  .ap-grid.solo{grid-template-columns:1fr}
  .ap-grid.solo .ap-tile{grid-template-columns:42% 1fr;grid-template-rows:none}
  .ap-grid.solo .ap-tile .vis{aspect-ratio:auto;min-height:172px}
  @media (min-width:760px){
    .ap-feat{grid-template-columns:1fr 200px}
    .ap-feat .ctas{display:flex;flex-wrap:wrap}
    .ap-feat .ap-btn{flex:0 1 260px}
    .ap-grid.solo .ap-tile{grid-template-columns:200px 1fr}
  }
  .ap-more{margin-top:12px;width:100%;min-height:44px;font:11px var(--f-mono);letter-spacing:.06em;border:1px dashed #ffffff40;border-radius:4px;background:transparent;color:var(--cream)}
  .ap-empty{grid-column:1/-1;padding:24px;text-align:center;font-size:14px;color:var(--mist);border:1px dashed #ffffff33;border-radius:10px;margin:0}
  .ap-foot{margin-top:28px;padding-top:16px;border-top:1px solid var(--teal-line);display:flex;flex-wrap:wrap;gap:8px 16px;font:11px var(--f-mono);letter-spacing:.08em;text-transform:uppercase;color:var(--mist-dim)}
  .ap-foot a:hover{color:var(--amber)}
</style>
