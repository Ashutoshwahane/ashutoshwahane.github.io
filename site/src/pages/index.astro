---
import { getWork, getPosts, readingMinutes, CATEGORIES } from '../lib/site';
import { person, website, ld } from '../lib/seo';
const featured = (await getWork()).filter((w) => w.data.featured).slice(0, 2);
const latest = (await getPosts()).slice(0, 3);
const total = (await getWork()).filter((w) => !w.data.draft).length;
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Ashutosh Wahane — Developer building independent apps</title><meta name="description" content="Android and Kotlin Multiplatform developer building independent apps like GlassPad and Leonida Insider. Work, product stories and notes on AI."><link rel="icon" href="/assets/img/favicon.ico"><link rel="canonical" href="https://ashutoshwahane.dev/"><meta name="author" content="Ashutosh Wahane"><meta property="og:type" content="website"><meta property="og:site_name" content="Ashutosh Wahane"><meta property="og:title" content="Ashutosh Wahane — Developer building independent apps"><meta property="og:description" content="Android and Kotlin Multiplatform developer building independent apps like GlassPad and Leonida Insider, and writing about how they get made."><meta property="og:url" content="https://ashutoshwahane.dev/"><meta property="og:image" content="https://ashutoshwahane.dev/og-default.jpg"><meta property="og:locale" content="en_IN"><meta name="twitter:card" content="summary_large_image"><meta name="twitter:image" content="https://ashutoshwahane.dev/og-default.jpg"><link rel="sitemap" href="/sitemap-index.xml"><script type="application/ld+json" set:html={ld(person, website)} /><link rel="stylesheet" href="/assets/css/main.css"><link rel="stylesheet" href="/assets/css/home-work.css"><link rel="alternate" type="application/rss+xml" title="Ashutosh Wahane — Writing" href="/blog/rss.xml"><script is:inline defer src="/assets/js/main.js"></script></head>
<body><a class="skip" href="#portfolio">Skip to portfolio</a><header><a class="brand" href="#">AW<span>®</span></a><span class="edition">PERSONAL EXPLORATIONS / VOL. 01</span><nav class="top-nav"><a class="index-link" href="/work/">Work <span>↗</span></a><a class="index-link" href="/blog/">Writing <span>↗</span></a><a class="index-link" href="#portfolio">Portfolio index <span>↗</span></a></nav></header>
<main><section class="stage" aria-labelledby="intro"><div class="intro"><span class="eyebrow">A SMALL DEVICE. A FEW DIFFERENT WORLDS.</span><h1 id="intro">Made of code.<br>Moved by <em>curiosity.</em></h1><p>Hey, I’m Ashutosh.<br>Developer, dancer, creative.<br>Currently exploring what to build next.</p><div class="annotation"><span>↘</span> Switch on. Get to know me.</div><div class="edition-note">POCKET PORTFOLIO<br><span>DESIGNED FOR A LITTLE EXPLORATION</span></div></div>
<div class="device-area"><div class="power-hint" aria-hidden="true">↓ START HERE</div><div class="console" aria-label="Interactive handheld portfolio"><div class="top-ridge"></div><div class="power-row"><span>OFF</span><button id="power" aria-label="Power on portfolio" aria-pressed="false"><span></span></button><span>ON</span><span class="model">AW—01</span></div><div class="screen-bezel"><div class="screen-label"><i></i><span>DOT MATRIX / PERSONAL UNIVERSE</span><i></i></div><div class="lcd-row"><div class="battery"><span id="led"></span><small>POWER</small></div><div class="screen" id="screen" tabindex="0" aria-label="Portfolio screen. Use arrow keys to select, Enter to open, Escape to go back."><div id="screen-content" aria-live="polite"></div></div></div><div class="screen-footer">FIVE WORLDS. ONE CURIOUS MIND.</div></div><div class="device-brand">Ashutosh<span>POCKET</span></div><div class="controls"><div class="dpad" role="group" aria-label="Navigation controls"><button class="up" data-move="-1" aria-label="Previous item">▲</button><button class="left" data-move="-1" aria-label="Previous item">◀</button><span class="dpad-center"></span><button class="right" data-move="1" aria-label="Next item">▶</button><button class="down" data-move="1" aria-label="Next item">▼</button></div><div class="action-buttons"><div><button id="back" aria-label="Go back">B</button><span>BACK</span></div><div><button id="open" aria-label="Open selected item">A</button><span>OPEN</span></div></div></div><div class="bottom-controls"><div><button id="select">SELECT</button><span>EXPLORE</span></div><div><button id="start">START</button><span>LET’S GO</span></div></div><div class="speaker" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></div><span class="serial">ASHUTOSH WAHANE · CREATIVE SYSTEM</span></div><div class="device-shadow"></div><p class="keyboard-note"><kbd>↑</kbd><kbd>↓</kbd> navigate <span>·</span> <kbd>↵</kbd> open <span>·</span> <kbd>esc</kbd> back</p></div></section>
<section class="home-work" id="work" aria-labelledby="work-title"><div class="hw-wrap">
<div class="hw-label"><span>SELECTED WORK</span><a href="/work/">ALL WORK ↗</a></div>
<h2 id="work-title" class="hw-title">Things I’ve <em>built.</em></h2>
<div class="hw-feature">
{featured.map((w) => (
<a class="hw-wcard" href={`/work/${w.id}/`}>
<div class={`hw-visual theme-${w.data.theme}`}><div class="hw-phone">{w.data.screenshot ? <img src={w.data.screenshot} alt={w.data.screenshotAlt ?? ''} loading="lazy" decoding="async" /> : <span></span>}</div></div>
<div class="hw-body">
<div class="hw-meta-row"><span>{w.data.platformsShort.toUpperCase()}</span><span class={w.data.status === 'building' ? 'hw-status dev' : 'hw-status'}><i></i>{w.data.statusLabel.toUpperCase()}</span></div>
<h3>{w.data.title}</h3>
<span class="hw-tag">{w.data.tagline}</span>
<p>{w.data.summary}</p>
<span class="hw-more">READ THE CASE STUDY →</span>
</div>
</a>
))}
</div>
<div class="hw-cta"><a href="/work/">SEE ALL {String(total).padStart(2, '0')} PRODUCTS →</a></div>
{latest.length > 0 && (<>
<div class="hw-label" style="margin-top:64px"><span>LATEST WRITING</span><a href="/blog/">ALL POSTS ↗</a></div>
<div class="hw-latest">
{latest.map((p) => (
<a href={`/blog/${p.id}/`}><span class="hw-meta"><span class="cat">{CATEGORIES[p.data.category].toUpperCase()}</span><span>{readingMinutes(p)} MIN</span>{p.data.draft && <span class="hw-draft">DRAFT</span>}</span><h3>{p.data.title}</h3></a>
))}
</div></>)}
</div></section>
<section class="portfolio" id="portfolio" aria-labelledby="index-title"><div class="section-label"><span>THE PORTFOLIO INDEX</span><span>NO BUTTONS REQUIRED ↓</span></div><div class="index-heading"><h2 id="index-title">More than one <em>mode.</em></h2><p>A few pieces of my world.<br>Pick a direction and take a look.</p></div><div class="cards"><article id="developer"><span class="card-number">01 / BUILD</span><span class="card-icon" aria-hidden="true">⌘</span><h3>Developer</h3><p>Mobile apps, useful tools, and experiments in motion. Explore my existing project archive.</p><a href="https://github.com/Ashutoshwahane">Explore GitHub ↗</a></article><article id="creative"><span class="card-number">02 / MOVE</span><span class="card-icon" aria-hidden="true">✳</span><h3>Dancer & creative</h3><p>Movement is another way I make things. A space for dance, creative experiments, and life beyond the editor.</p><a href="https://www.instagram.com/ashutoshwahane/">Find me on Instagram ↗</a></article><article id="building"><span class="card-number">03 / EXPLORE</span><span class="card-icon" aria-hidden="true">↗</span><h3>Building next</h3><p>I’m exploring what it takes to build a startup of my own. This chapter is still taking shape.</p><a href="mailto:ashutosh.wahane10@gmail.com">Exchange an idea ↗</a></article><article id="about"><span class="card-number">04 / CONNECT</span><img class="portrait" src="/assets/img/profile.jpg" alt="Ashutosh Wahane" loading="lazy"><h3>Hey, I’m Ashutosh.</h3><p>Developer, dancer, and creative. Curious about software, movement, and where an idea might lead.</p><a href="mailto:ashutosh.wahane10@gmail.com">Say hello ↗</a></article></div></section></main><footer><span>© <span id="year">{new Date().getFullYear()}</span> ASHUTOSH WAHANE</span><span class="prototype">LOCAL PROTOTYPE · GAME WORLD COMING LATER</span><a href="https://www.linkedin.com/in/ashutoshwahane/">LinkedIn ↗</a></footer></body></html>
